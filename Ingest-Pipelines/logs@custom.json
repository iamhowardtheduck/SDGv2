{
  "processors": [
    {
      "pipeline": {
        "name": "logs-windows.sysmon_operational",
        "ignore_missing_pipeline": true,
        "if": "ctx.containsKey('wincode') && ctx.wincode != null && ctx.wincode != ''",
        "ignore_failure": true
      }
    },
    {
      "pipeline": {
        "name": "enrich-logs-network_traffic",
        "ignore_missing_pipeline": true,
        "if": "ctx.containsKey('dnsoptudpsize') && ctx.dnsoptudpsize != null && ctx.dnsoptudpsize != ''",
        "ignore_failure": true
      }
    },
    {
      "pipeline": {
        "name": "logs-netflow.log",
        "ignore_missing_pipeline": true,
        "if": "ctx.containsKey('networkdirection') && ctx.networkdirection != null && ctx.networkdirection != ''",
        "ignore_failure": true
      }
    },
    {
      "pipeline": {
        "name": "enrich-bluecoat",
        "ignore_missing_pipeline": true,
        "if": "ctx.containsKey('proxyresponsebytes') && ctx.proxyresponsebytes != null && ctx.proxyresponsebytes != ''",
        "ignore_failure": true
      }
    },
    {
      "pipeline": {
        "name": "enrich-email",
        "ignore_missing_pipeline": true,
        "if": "ctx.containsKey('fname') && ctx.fname != null && ctx.fname != ''",
        "ignore_failure": true
      }
    },
    {
      "pipeline": {
        "name": "logs-ti_abusech.malware@custom",
        "ignore_missing_pipeline": true,
        "if": "ctx.containsKey('extension') && ctx.extension != null && ctx.extension != ''",
        "ignore_failure": true
      }
    }
  ]
}
