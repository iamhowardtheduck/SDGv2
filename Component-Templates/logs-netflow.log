            "match": "message_id"
          }
        },
        {
          "_embedded_ecs-command_line_to_multifield": {
            "mapping": {
              "fields": {
                "text": {
                  "type": "match_only_text"
                }
              },
              "type": "wildcard"
            },
            "match": "command_line"
          }
        },
        {
          "_embedded_ecs-error_stack_trace_to_multifield": {
